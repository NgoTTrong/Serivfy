# Supabase Postgres — pooled (port 6543) for app runtime
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) used by Prisma migrations
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Staff auth signing key. For prod use a strong random secret.
AUTH_SECRET="dev-secret-change-me"

# Base URL (used when generating QR codes). On Vercel set to https://<your-domain>
NEXT_PUBLIC_APP_URL="http://localhost:3000"
